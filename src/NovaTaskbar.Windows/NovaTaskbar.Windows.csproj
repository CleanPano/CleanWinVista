<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integração Win32 isolada (sem WinUI): janelas, processos, Shell, DWM. Testável por NovaTaskbar.IntegrationTests. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NovaTaskbar.Windows</RootNamespace>
    <Platforms>x64;ARM64;AnyCPU</Platforms>
    <NoWarn>$(NoWarn);CA1416;SYSLIB1054</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovaTaskbar.Core\NovaTaskbar.Core.csproj" />
  </ItemGroup>

</Project>
