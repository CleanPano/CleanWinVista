<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>NovaTaskbar.App</RootNamespace>
    <AssemblyName>NovaTaskbar</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Não empacotado: o Dock precisa de Win32 (regiões de janela, estilos estendidos, DWM). Ver docs/ARCHITECTURE.md (ADR-003). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.1</Version>
    <Product>CleanWinVista</Product>
    <AssemblyTitle>CleanWinVista</AssemblyTitle>
    <Company>ElChef</Company>
    <Description>CleanWinVista — dock limpo e flutuante para Windows 11</Description>
    <!-- CsWinRT: avisos de compatibilidade AOT não se aplicam (sem trimming/AOT nesta fase). -->
    <NoWarn>$(NoWarn);CsWinRT1028;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\CleanWinVista.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\CleanWinVista.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\CleanWinVista-64.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Traduções (texto-fonte em inglês; 19 idiomas) -->
    <Content Include="i18n\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovaTaskbar.Core\NovaTaskbar.Core.csproj" />
    <ProjectReference Include="..\NovaTaskbar.Windows\NovaTaskbar.Windows.csproj" />
  </ItemGroup>

</Project>
